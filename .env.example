# Public site URL used for canonical links, Open Graph, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Where inquiry and newsletter submissions are POSTed as JSON.
# Leave empty in development to log submissions to the server console.
INQUIRY_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# Optional: sent as "Authorization: Bearer <secret>" to both webhooks.
FORM_WEBHOOK_SECRET=
